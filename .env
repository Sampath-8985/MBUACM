# Firebase Configuration
# Fill in your Firebase project web credentials from the Firebase Console (Project Settings -> General -> Your apps -> Web app).
# When left blank or with placeholders, the app runs in interactive hybrid demo mode with pre-seeded data.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
