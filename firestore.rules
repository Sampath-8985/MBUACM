rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin = a document  user_roles/{uid}  with  role: "admin"  (create it manually in the console)
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/user_roles/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data.role == 'admin';
    }

    match /user_roles/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /events/{id} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow write: if isAdmin();
    }

    match /crew_members/{id} {
      allow read: if resource.data.is_published == true || isAdmin();
      allow write: if isAdmin();
    }

    match /event_gallery/{id} {
      allow read: if resource.data.is_published == true || isAdmin();
      allow write: if isAdmin();
    }

    match /categories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Anyone can send a contact message; only admins can read or manage them
    match /contacts/{id} {
      allow create: if request.resource.data.keys().hasAll(['name', 'email', 'subject', 'message'])
        && request.resource.data.message.size() < 5000;
      allow read, update, delete: if isAdmin();
    }
  }
}
